# ── Database (Supabase — Project Settings > Database > Connection string) ─────
# Use the SESSION pooler (port 5432): it supports asyncpg prepared statements and
# suits a persistent/always-on server. (Transaction mode / 6543 needs prepared
# statements disabled and is meant for serverless.) Setting only DATABASE_URL_SYNC
# is enough — the async URL is derived automatically in app/core/config.py.
DATABASE_URL=postgresql+asyncpg://postgres.XXXX:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL_SYNC=postgresql://postgres.XXXX:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Connection-pool sizing — small defaults keep total connections within free
# managed-Postgres caps (Supabase free ≈ 60). Raise on a bigger plan.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
SYNC_DB_POOL_SIZE=2
SYNC_DB_MAX_OVERFLOW=3

# ── JWT (generate: openssl rand -hex 32) ─────────────────────────────────────
# In production the app refuses to start if JWT_SECRET is a default / <32 chars.
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Security ──────────────────────────────────────────────────────────────────
# Comma-separated allowed CORS origins (NO wildcard in production).
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
# Per-IP rate limit applied to /auth/login and /auth/register.
AUTH_RATE_LIMIT=5/minute
# Set false to hide /docs and /redoc (forced off automatically in production).
DOCS_ENABLED=true

# ── Observabilidad y analítica (opcionales; vacío = desactivado) ───────────────
SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# ── Redis (Upstash Console > REST API > Redis URL) ────────────────────────────
REDIS_URL=rediss://default:PASSWORD@HOST.upstash.io:6379

# ── Satellite STAC ────────────────────────────────────────────────────────────
STAC_API_URL=https://earth-search.aws.element84.com/v1

# ── Storage ───────────────────────────────────────────────────────────────────
DATA_DIR=/app/data

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO
# Public origin — used to build MercadoPago back_urls + webhook notification_url.
PUBLIC_BASE_URL=https://your-domain.example

# ── AgroBot (DeepSeek) ─────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=

# ── MercadoPago (Checkout Pro) ─────────────────────────────────────────────────
# Empty = billing runs in preview-only mode, no real charge. Get TEST-... creds
# from https://www.mercadopago.com.mx/developers/panel/app for sandbox testing;
# swap to APP_USR-... only when ready to charge for real.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
